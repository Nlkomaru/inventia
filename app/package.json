{
	"name": "inventia",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "pnpm run generate-licenses && vite dev --port 3000 --host",
		"generate-licenses": "pnpm licenses list --prod --json | node scripts/generate-license-data.mjs",
		"generate-routes": "tsr generate",
		"build": "pnpm run generate-licenses && vite build",
		"preview": "pnpm run build && vite preview",
		"check": "biome check --write",
		"deploy": "VITE_DEPLOYED_AT=$(date -u +%Y-%m-%dT%H:%M:%S.000Z) pnpm run build && cf deploy --prebuilt",
		"cf-typegen": "cf workers types",
		"test": "vitest run"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@cfworker/json-schema": "^4.1.6",
		"@fontsource-variable/noto-sans-jp": "^5.3.1",
		"@fontsource-variable/playfair-display": "^5.3.0",
		"@fontsource/poppins": "^5.3.0",
		"@hono/mcp": "^0.3.5",
		"@hono/zod-openapi": "^1.6.3",
		"@modelcontextprotocol/sdk": "^1.32.2",
		"@openrouter/ai-sdk-provider": "^3.1.0",
		"@scalar/hono-api-reference": "^0.11.16",
		"@tailwindcss/vite": "^4.3.5",
		"@tanstack/react-devtools": "latest",
		"@tanstack/react-query": "^5.108.3",
		"@tanstack/react-router": "catalog:",
		"@tanstack/react-router-devtools": "latest",
		"@tanstack/react-router-ssr-query": "^1.167.3",
		"@tanstack/react-start": "latest",
		"@tanstack/react-table": "^9.3.1",
		"ai": "^7.0.179",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"drizzle-orm": "^0.45.4",
		"hono": "^4.13.20",
		"hono-rate-limiter": "^0.5.4",
		"jotai": "^2.20.3",
		"lucide-react": "^1.77.0",
		"react": "^19.3.1",
		"react-day-picker": "^10.0.2",
		"react-dom": "^19.3.1",
		"react-dropzone": "^20.2.1",
		"shadcn": "^4.23.0",
		"tailwind-merge": "^3.7.1",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"uuid": "^14.0.3",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@cloudflare/vite-plugin": "2.0.0-rc.0",
		"@cloudflare/vitest-pool-workers": "^0.22.0",
		"@tanstack/devtools-vite": "latest",
		"@tanstack/react-query-devtools": "^5.108.3",
		"@tanstack/router-cli": "^1.168.0",
		"@types/node": "^22.20.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"cf": "1.0.0-rc.2",
		"drizzle-kit": "^0.31.11",
		"typescript": "^6.0.2",
		"vite": "^8.3.8",
