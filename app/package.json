{
	"name": "inventia",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "pnpm run generate-licenses && vite dev --port 3000 --host",
		"generate-licenses": "pnpm licenses list --prod --json | node scripts/generate-license-data.mjs",
		"generate-routes": "tsr generate",
		"build": "pnpm run generate-licenses && vite build",
		"preview": "pnpm run build && vite preview",
		"check": "biome check --write",
		"deploy": "VITE_DEPLOYED_AT=$(date -u +%Y-%m-%dT%H:%M:%S.000Z) pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types"
	},
	"dependencies": {
		"@base-ui/react": "^1.7.0",
		"@cfworker/json-schema": "^4.1.1",
		"@fontsource-variable/noto-sans-jp": "^5.3.0",
		"@fontsource-variable/playfair-display": "^5.3.0",
		"@fontsource/poppins": "^5.3.0",
		"@hono/mcp": "^0.3.1",
		"@hono/zod-openapi": "^1.5.1",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@openrouter/ai-sdk-provider": "^3.0.0",
		"@scalar/hono-api-reference": "^0.11.12",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-devtools": "latest",
		"@tanstack/react-query": "^5.101.4",
		"@tanstack/react-router": "latest",
		"@tanstack/react-router-devtools": "latest",
		"@tanstack/react-router-ssr-query": "^1.167.1",
		"@tanstack/react-start": "latest",
		"@tanstack/react-table": "^9.1.2",
		"ai": "^7.0.66",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.13.0",
		"hono-rate-limiter": "^0.5.3",
		"jotai": "^2.20.2",
		"lucide-react": "^1.31.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-dropzone": "^20.1.0",
		"shadcn": "^4.16.2",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"uuid": "^14.0.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@cloudflare/vite-plugin": "^1.26.0",
		"@tanstack/devtools-vite": "latest",
		"@tanstack/react-query-devtools": "^5.101.4",
		"@tanstack/router-cli": "^1.132.0",
		"@types/node": "^22.20.1",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"drizzle-kit": "^0.31.10",
		"typescript": "^6.0.2",
		"vite": "^8.0.0",
		"wrangler": "^4.119.0"
	}
}
